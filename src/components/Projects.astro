---
import SectionContainer from "./SectionContainer.astro"
import SectionHeading from "./SectionHeading.astro"
import ProjectVisual from "./ProjectVisual.astro"
import CodeIcon from "../icons/Code.astro"
import GitHubIcon from "../icons/GitHub.astro"
import LinkIcon from "../icons/Link.astro"
import { COPY, type Lang } from "../i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { featured, workshop, sections } = COPY[lang]

// Asymmetric workshop grid: wide, narrow / narrow, wide
const spans = ["md:col-span-4", "md:col-span-2", "md:col-span-2", "md:col-span-4"]
---

<SectionContainer id="projects">
  <SectionHeading numeral="II" title={sections.projects} intro={sections.projectsIntro}>
    <CodeIcon class="size-7" />
  </SectionHeading>

  <div class="flex flex-col gap-[clamp(4rem,7vw,6rem)]">
    {
      featured.map((p, i) => (
        <article class="grid items-center gap-8 md:grid-cols-12 md:gap-12" data-reveal>
          <div class:list={["md:col-span-7", i % 2 === 1 && "md:order-2"]}>
            <div class="card riveted lift p-3">
              <ProjectVisual visual={p.visual} lang={lang} />
            </div>
          </div>

          <div class:list={["md:col-span-5", i % 2 === 1 && "md:order-1"]}>
            <p class="meta uppercase">{p.context}</p>
            <h3 class="mt-2 text-[1.75rem] leading-tight">{p.title}</h3>
            <p class="mt-4 max-w-[72ch]">{p.description}</p>
            {p.highlights && (
              <ul class="bullets mt-4 space-y-2 text-[0.95rem]">
                {p.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {p.note && <p class="mt-4 text-sm italic text-sepia">{p.note}</p>}
            <ul class="mt-5 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
            {p.links.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a class="btn btn-ghost px-4 py-2 text-base" href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.type === "code" ? <GitHubIcon class="size-4 fill-current" /> : <LinkIcon class="size-4" />}
                    {l.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-[clamp(4rem,8vw,7rem)]">
    <div class="mb-8" data-reveal>
      <h3 class="text-[1.75rem] leading-tight">{sections.workshop}</h3>
      <p class="mt-2 text-sepia">{sections.workshopIntro}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-6">
      {
        workshop.map((p, i) => {
          const wide = spans[i % spans.length] === "md:col-span-4"
          return (
            <div class:list={[spans[i % spans.length]]} data-reveal style={`--i:${i % 2}`}>
              <article class="card riveted lift flex h-full flex-col gap-5 p-5">
                <div class="overflow-hidden rounded-md border border-copper/40">
                  <ProjectVisual visual={p.visual} lang={lang} aspect={wide ? "aspect-[16/10] md:aspect-[21/9]" : "aspect-[16/10]"} />
                </div>
                <div>
                  <p class="meta text-[0.72rem] uppercase">{p.context}</p>
                  <h4 class="mt-1.5 text-[1.4rem] leading-snug">{p.title}</h4>
                  <p class="mt-3 text-[0.95rem]">{p.description}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {p.tags.map((t) => (
                      <li class="chip">{t}</li>
                    ))}
                  </ul>
                  {p.links.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                      {p.links.map((l) => (
                        <a class="ink-link inline-flex items-center gap-1.5" href={l.href} target="_blank" rel="noopener noreferrer">
                          {l.type === "code" ? <GitHubIcon class="size-4 fill-current" /> : <LinkIcon class="size-4" />}
                          {l.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            </div>
          )
        })
      }
    </div>
  </div>
</SectionContainer>
