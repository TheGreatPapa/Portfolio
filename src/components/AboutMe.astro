---
import SectionContainer from "./SectionContainer.astro"
import SectionHeading from "./SectionHeading.astro"
import PersonIcon from "../icons/Person.astro"
import { COPY, type Lang } from "../i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { about, sections } = COPY[lang]
---

<SectionContainer id="about">
  <SectionHeading numeral="III" title={sections.about}>
    <PersonIcon class="size-7" />
  </SectionHeading>

  <div class="grid gap-10 md:grid-cols-12 md:gap-14">
    <div class="space-y-5 text-lg md:col-span-7">
      {
        about.paragraphs.map((p, i) => (
          <p class:list={["max-w-[72ch]", i === 0 && "dropcap"]} data-reveal style={`--i:${i}`}>
            {p}
          </p>
        ))
      }
    </div>

    <aside class="md:col-span-5" data-reveal style="--i:1">
      <div class="card riveted p-6 md:p-8">
        <h3 class="text-[1.5rem]">{sections.credentials}</h3>
        <ol class="mt-4 divide-y divide-copper/30">
          {
            about.credentials.map((c) => (
              <li class="py-3">
                <p class="leading-snug">{c.title}</p>
                <p class="meta mt-1 text-[0.75rem]">{c.detail}</p>
              </li>
            ))
          }
        </ol>
        <h3 class="mt-6 text-[1.5rem]">{sections.languages}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {about.languages.map((l) => <li class="chip">{l}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</SectionContainer>

<style>
  .dropcap::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-size: 3.6em;
    line-height: 0.8;
    color: var(--color-mahogany);
    text-shadow: 2px 2px 0 rgb(181 166 66 / 0.6);
  }
</style>
