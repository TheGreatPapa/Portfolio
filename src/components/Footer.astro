---
import Gear from "./Gear.astro"
import GitHubIcon from "../icons/GitHub.astro"
import LinkedInIcon from "../icons/LinkedIn.astro"
import MailIcon from "../icons/Mail.astro"
import { COPY, CONTACT, type Lang } from "../i18n/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { footer } = COPY[lang]
const year = new Date().getFullYear()
---

<footer id="contact" class="leather mt-[clamp(2rem,4vw,4rem)] overflow-hidden">
  <div class="stitched relative mx-auto max-w-[1280px] px-6 py-[clamp(4rem,8vw,6rem)]">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="md:col-span-8" data-reveal>
        <h2 class="text-[clamp(2.25rem,4vw,3rem)] leading-tight text-ivory">{footer.heading}</h2>
        <p class="mt-3 max-w-[60ch] text-lg text-parchment/85">{footer.text}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a class="btn btn-primary" href={`mailto:${CONTACT.email}`}>
            <MailIcon class="size-5" />
            {footer.email}
          </a>
          <a class="footer-link inline-flex items-center gap-2" href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">
            <LinkedInIcon class="size-4 fill-current" /> LinkedIn
          </a>
          <a class="footer-link inline-flex items-center gap-2" href={CONTACT.github} target="_blank" rel="noopener noreferrer">
            <GitHubIcon class="size-4 fill-current" /> GitHub
          </a>
        </div>
        <p class="meta mt-6 text-brass-light">{CONTACT.email}</p>
      </div>

      <div class="relative hidden h-48 md:col-span-4 md:block" aria-hidden="true">
        <Gear teeth={24} module={6} phase={146.25} class="gear-spin absolute right-10 top-0 w-44 text-copper/50" style="--gear-duration:60s" />
        <Gear teeth={12} module={6} phase={307.5} class="gear-spin absolute right-[11.5rem] top-[6.25rem] w-24 text-brass/45" style="--gear-duration:30s;--gear-direction:reverse" />
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-parchment/20 pt-6 text-sm text-parchment/75 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {footer.rights}. {footer.built}</p>
      <a class="footer-link" href="#top">{footer.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--color-brass-light);
    text-decoration: underline;
    text-decoration-color: rgb(220 207 122 / 0.35);
    text-underline-offset: 3px;
  }

  .footer-link:hover {
    text-decoration-color: currentColor;
  }
</style>
