---
import type { Job } from "../i18n/content"

type Props = Job

const { role, company, url, period, location, note, bullets, tags } = Astro.props
---

<div class="grid gap-y-3 pl-11 md:grid-cols-[14rem_1fr] md:gap-x-10 md:pl-0">
  <div class="md:sticky md:top-28 md:self-start md:pr-4 md:text-right">
    <p class="meta uppercase">{period}</p>
    <p class="italic text-sepia">{location}</p>
  </div>

  <article class="card riveted p-6 md:p-8">
    <h3 class="text-2xl leading-snug">{role}</h3>
    <a class="ink-link text-lg" href={url} target="_blank" rel="noopener noreferrer">{company}</a>
    {note && <p class="mt-3 max-w-[72ch] italic text-sepia">{note}</p>}

    <ul class="bullets mt-5 max-w-[72ch] space-y-2.5">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>

    <ul class="mt-6 flex flex-wrap gap-2">
      {tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </article>
</div>
