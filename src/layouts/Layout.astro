---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { COPY, LANGS, pathFor, type Lang } from "../i18n/content"

import "@fontsource/im-fell-english/400.css"
import "@fontsource/im-fell-english/400-italic.css"
import "@fontsource-variable/jetbrains-mono"
import "../styles/global.css"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { meta } = COPY[lang]
const site = Astro.site ?? new URL("https://luisluca.dev")
const canonical = new URL(pathFor(lang), site)
const ogImage = new URL("/og.jpg", site)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#3E2414" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor("en"), site)} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.locale} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <title>{meta.title}</title>
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>
  </head>

  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />

    <script>
      const revealed = document.querySelectorAll<HTMLElement>("[data-reveal]")
      const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")

      if (!("IntersectionObserver" in window)) {
        revealed.forEach((el) => el.classList.add("is-visible"))
      } else {
        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add("is-visible")
              revealer.unobserve(entry.target)
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        )
        revealed.forEach((el) => revealer.observe(el))

        // Mark the nav item for the section currently in view
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              const id = entry.target.id
              navLinks.forEach((link) => {
                if (link.hash === `#${id}`) link.setAttribute("aria-current", "true")
                else link.removeAttribute("aria-current")
              })
            }
          },
          { rootMargin: "-45% 0px -50% 0px" },
        )
        document.querySelectorAll("main section[id], footer[id]").forEach((el) => spy.observe(el))
      }
    </script>
  </body>
</html>
